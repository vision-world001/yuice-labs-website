# EmailJS (https://dashboard.emailjs.com) — copy this file to .env and fill in your own values.
# Email Services -> your Gmail service -> Service ID
VITE_EMAILJS_SERVICE_ID=service_REPLACE_ME
# Email Templates -> the "Website form" template -> Template ID
VITE_EMAILJS_TEMPLATE_ID=template_REPLACE_ME
# Account -> General -> Public Key
VITE_EMAILJS_PUBLIC_KEY=REPLACE_ME
# Company inbox that receives the forms (your Gmail address). In the EmailJS template, set To Email to {{to_email}} or to this same address.
VITE_COMPANY_EMAIL=you@yourcompany.com
